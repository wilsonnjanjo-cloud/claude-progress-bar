{
  "description": "Feeds the Claude Progress Bar window",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; [ \"$(uname -s)\" = Darwin ] && P=python3; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" 2>/dev/null || true",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Agent|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; [ \"$(uname -s)\" = Darwin ] && P=python3; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" 2>/dev/null || true",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; [ \"$(uname -s)\" = Darwin ] && P=python3; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" 2>/dev/null || true",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python; [ \"$(uname -s)\" = Darwin ] && P=python3; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" 2>/dev/null || true",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python; [ \"$(uname -s)\" = Darwin ] && P=python3; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" 2>/dev/null || true",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}